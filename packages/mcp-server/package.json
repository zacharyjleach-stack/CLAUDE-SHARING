{
  "name": "@claude-sharing/mcp-server",
  "version": "0.2.0",
  "description": "MCP server that lets a Claude Code session query a paired teammate's synced activity.",
  "type": "module",
  "bin": {
    "claude-sharing-mcp": "dist/index.js"
  },
